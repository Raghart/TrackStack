  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "tsx dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:validate": "prisma validate --config database/prisma.config.ts",
    "db:generate": "prisma generate --config database/prisma.config.ts",
    "db:status": "prisma migrate status --config database/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config database/prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config database/prisma.config.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.0",
    "@as-integrations/express5": "^1.1.2",
    "@google/genai": "^1.46.0",
    "@nestjs/apollo": "^13.2.4",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/graphql": "^13.2.4",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/sequelize": "^11.0.0",
    "@nestjs/serve-static": "^5.0.4",
    "@prisma/client": "^7.10.1",
    "@trackstack/schemas": "workspace:*",
    "cors": "^2.8.5",
    "coverage": "^0.0.0",
    "express": "^5.1.0",
    "graphql": "^16.11.0",
    "pg": "^8.16.0",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "tsx": "^4.23.15",
    "umzug": "^3.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.0.0",
    "@swc/cli": "^0.5.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.15",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "2.0.0",
    "vitest": "^5.0.5"
  }
}
